# Environment variables for development
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/rajkamal_db?schema=public"

# Connection pool tuning — append to DATABASE_URL as query params
# connection_limit: max open connections per Prisma client (each client has its own pool)
# Note: two clients exist (main + sales), so total max = connection_limit * 2
# For Vercel/serverless with a managed DB pooler (Neon pooled, Supabase pooler): set to 1-3
# For direct connection (self-hosted Postgres): set to 10-20
DB_CONNECTION_LIMIT=20
DB_POOL_TIMEOUT=30
# To activate: append ?connection_limit=${DB_CONNECTION_LIMIT}&pool_timeout=${DB_POOL_TIMEOUT} to DATABASE_URL
# Example: DATABASE_URL="postgresql://user:pass@host:5432/db?connection_limit=20&pool_timeout=30"

# Slow query logging — queries slower than this threshold (ms) appear in logs
SLOW_QUERY_THRESHOLD_MS=500

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Fixed admin bootstrap (created at startup if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_123!
ADMIN_NAME=Administrator

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Allowed CORS origins (comma-separated). Takes precedence over FRONTEND_URL.
# On the Hostinger VPS set this to include the live domain, e.g.:
# CORS_ORIGINS=https://dashboard-rk.duckdns.org,http://localhost:5173,http://localhost:3000
# CORS_ORIGINS=

# API Configuration
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# ── Sheet archive & corruption guard ─────────────────────────────────────────
# The Google-Sheet sync is wipe-and-replace: it deletes every row in a region table
# before re-inserting. The archive captures each raw sheet export and a pre-wipe copy
# of the table, so a corrupted sheet can never permanently destroy data.
#
# ARCHIVE_DATABASE_URL points at a SEPARATE Postgres. On the VPS that is a second
# Postgres container on port 5433 with its own volume (the application DB container
# holds 5432). Isolation is the point: an archive inside the main DB shares every
# failure mode it exists to survive. See backend/SHEET_ARCHIVE.md for the setup.
#
# If this is UNSET, the entire feature is inert: no tables, no rows, no guard, and the
# sync runs exactly as it did before. It NEVER falls back to the application database.
ARCHIVE_DATABASE_URL="postgresql://rk_archive:CHANGE_ME@localhost:5433/rk_archive"

# Master switch. Set to false to disable archiving AND the guard entirely.
ARCHIVE_ENABLED=true

# What happens when an incoming export looks corrupted:
#   block (default) — refuse the import; the live table keeps its previous data
#   warn            — import anyway, but record the finding on the dump
#   off             — skip validation entirely
ARCHIVE_GUARD=block

# Collapse thresholds, as a fraction of the last accepted export. An export with fewer
# than 70% of the previous row count (or total amount) is treated as corrupted.
# Loosen toward 0.5 if a region legitimately swings hard day to day.
ARCHIVE_GUARD_MIN_ROW_RATIO=0.7
ARCHIVE_GUARD_MIN_AMOUNT_RATIO=0.7

# Store the full pre-wipe rows, not just counts. Set false to keep summaries only —
# much cheaper, but restores then depend on replaying an archived export.
ARCHIVE_SNAPSHOT_ROWS=true
# Include the verbatim rawJson column in snapshots. Roughly triples snapshot size and
# duplicates what the dump archive already holds.
ARCHIVE_SNAPSHOT_RAW_JSON=false
ARCHIVE_SNAPSHOT_PAGE_SIZE=5000

# Blob retention ladder (metadata rows are kept forever, only the gzipped bodies age
# out): every capture for N days, then one per week for N weeks, then one per month.
ARCHIVE_RETAIN_DAILY_DAYS=30
ARCHIVE_RETAIN_WEEKLY_WEEKS=26

# Re-enable the legacy headers_debug.log append (off by default: the parser now runs
# twice per sync, and archived dumps record the headers durably).
SYNC_DEBUG_HEADERS=false
